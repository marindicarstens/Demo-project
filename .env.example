# Copy this file to .env and fill in real local values before running `docker compose up`.
# .env is git-ignored — never commit real secrets.

# --- Database ---
POSTGRES_DB=demo_booking
POSTGRES_USER=demo_booking
POSTGRES_PASSWORD=changeme
POSTGRES_PORT=5432

# --- Cache / rate limiting / idempotency ---
REDIS_PORT=6379

# --- Backend (Spring Boot) ---
BACKEND_PORT=8080
SPRING_PROFILES_ACTIVE=docker
# Required, at least 32 bytes - the backend refuses to start without it. Generate with:
#   openssl rand -base64 32   (see README Quick start for a one-line sed that fills it in)
APP_JWT_SIGNING_SECRET=
# Kept short (1 min) for easy demoing/testing; a real deployment would likely use 10-15
APP_CONFIRMATION_TOKEN_TTL_MINUTES=1
APP_RESCHEDULE_MIN_NOTICE_HOURS=2
# Per-client-IP rate limits (attempts per window). Raise the first two for load tests run from
# one host, where every request shares one client IP.
# APP_RATE_LIMIT_BOOKING_CREATE_MAX_ATTEMPTS=200
# APP_RATE_LIMIT_LOOKUP_MAX_ATTEMPTS=200
# APP_RATE_LIMIT_DIRECTORY_VALIDATION_MAX_ATTEMPTS=5
# APP_RATE_LIMIT_WINDOW=PT15M

# --- Frontend (Angular, served by Nginx) ---
FRONTEND_PORT=4200
